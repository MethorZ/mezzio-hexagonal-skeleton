{
    "name": "methorz/mezzio-hexagonal-skeleton",
    "description": "Mezzio skeleton with architecture choice: minimal or hexagonal (DDD). Includes optional packages for modern PHP 8.5.12+ REST API development.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "mezzio",
        "skeleton",
        "hexagonal-architecture",
        "ddd",
        "domain-driven-design",
        "clean-architecture",
        "rest-api",
        "php8"
    ],
    "config": {
        "vendor-dir": "backend/vendor",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-component-installer": true
        },
        "platform": {
            "php": "8.5.12"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laminas": {
            "component-whitelist": [
                "mezzio/mezzio",
                "mezzio/mezzio-helpers",
                "mezzio/mezzio-router",
                "laminas/laminas-httphandlerrunner",
                "mezzio/mezzio-fastroute",
                "mezzio/mezzio-cors"
            ]
        }
    },
    "require": {
        "php": "~8.5.12",
        "laminas/laminas-config-aggregator": "^1.20",
        "laminas/laminas-diactoros": "^3.9",
        "laminas/laminas-servicemanager": "^4.5",
        "mezzio/mezzio": "^3.28",
        "mezzio/mezzio-fastroute": "^3.14",
        "mezzio/mezzio-helpers": "^5.20"
    },
    "require-dev": {
        "laminas/laminas-development-mode": "^3.15",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-latest",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "suggest": {
        "methorz/swift-db": "High-performance MySQL database layer with Laravel-style query builder (^1.3)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/src/App/",
            "SkeletonInstaller\\": "backend/src/SkeletonInstaller/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "backend/src/App/Tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "./setup.sh"
        ],
        "setup-installer": [
            "SkeletonInstaller\\OptionalPackages::install"
        ],
        "post-install-cmd": "@clear-config-cache",
        "post-update-cmd": "@clear-config-cache",
        "development-disable": "laminas-development-mode disable",
        "development-enable": "laminas-development-mode enable",
        "development-status": "laminas-development-mode status",
        "check": [
            "@cs-check",
            "@analyze",
            "@test"
        ],
        "analyze": "phpstan analyze --memory-limit=512M",
        "clear-config-cache": "php backend/bin/clear-config-cache.php",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t backend/public/"
        ],
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "scripts-descriptions": {
        "check": "Run all quality checks (code style, static analysis, tests).",
        "analyze": "Run static analysis with PHPStan at level 9.",
        "clear-config-cache": "Clears merged config cache. Required for config changes to be applied."
    }
}

